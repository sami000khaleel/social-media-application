# where the MongoDB database is (local MongoDB, or the connection string from MongoDB Atlas)
DATABASE_URL=mongodb://127.0.0.1:27017/social-app
# any long random text; it signs the login tokens
JWT_SECRET=change-this-to-a-long-random-string
PORT=1000

# the public demo for visitors: one-click sign in as a made-up person, no writing in those accounts.
# WARNING: with DEMO_MODE=true ALL data is deleted and reloaded every DEMO_RESET_HOURS hours.
DEMO_MODE=false
DEMO_RESET_HOURS=6
# Only for two deployments (front end on its own address): that address, so only it may call the API.
# CLIENT_URL=https://upswing-web.onrender.com
